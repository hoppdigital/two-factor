{
  "name": "two-factor",
  "title": "Two Factor",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/wordpress/two-factor",
  "scripts": {
    "env": "wp-env",
    "build": "grunt build",
    "lint": "npm-run-all lint:*",
    "lint:php": "composer lint",
    "lint:phpstan": "composer lint-phpstan",
    "lint:css": "wp-scripts lint-style ./user-edit.css",
    "lint:js": "wp-scripts lint-js ./Gruntfile.js",
    "format": "npm-run-all format:*",
    "format:php": "composer format",
    "format:js": "npm run lint:js -- --fix",
    "format:css": "npm run lint:css -- --fix",
    "test": "npm run composer test",
    "test:watch": "npm run composer test:watch",
    "composer": "wp-env run tests-cli --env-cwd=wp-content/plugins/two-factor composer --",
    "preinstall": "composer install",
    "blueprint": "grunt blueprint-url"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wordpress/two-factor.git"
  },
  "author": "georgestephanis",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@wordpress/env": "^11.16.0",
    "@wordpress/eslint-plugin": "^22.16.0",
    "@wordpress/scripts": "^35.0.0",
    "grunt": "^1.6.3",
    "grunt-cli": "^1.5.0",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-copy": "^1.0.0",
    "load-grunt-tasks": "^5.1.0",
    "npm-run-all": "^4.1.5",
    "parse-gitignore": "^0.5.1"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    },
    "adm-zip": "^0.6.0",
    "axios": "^1.18.0",
    "baseline-browser-mapping": "^2.11.0",
    "basic-ftp": "^5.2.2",
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.6",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "glob": "^10.5.0",
    "http-proxy-middleware": "^2.0.10",
    "immutable": "^5.1.8",
    "ip-address": "^10.3.1",
    "joi": "^17.13.6",
    "js-yaml": "^4.3.2",
    "launch-editor": "^2.14.1",
    "linkify-it": "^5.0.2",
    "lodash": "^4.18.0",
    "lodash-es": "^4.18.0",
    "markdown-it": "^14.2.0",
    "markdownlint-cli": {
      "minimatch": "^3.1.4"
    },
    "nanoid": "^3.3.12",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.3",
    "qs": "^6.15.2",
    "serialize-javascript": "^7.0.5",
    "shell-quote": "^1.9.0",
    "simple-git": "^3.36.0",
    "svgo": "^3.3.5",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.6",
    "websocket-driver": "^0.7.5"
  }
}
